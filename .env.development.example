# Local developoment profile. Copy to .env.development.local; use the same Mongo credentials and port as .env.
WIKIPLOTTER_ENV=development
MONGO_INITDB_ROOT_USERNAME=replace_me
MONGO_INITDB_ROOT_PASSWORD=replace_me
MONGO_BIND_HOST=127.0.0.1
MONGO_PORT=27018
MONGODB_URL=mongodb://replace_me:replace_me@127.0.0.1:27018/wikiplotter_dev?authSource=admin
HOST=127.0.0.1
PORT=3001
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5174

# Authentication: use this exact browser origin for Google and MIT SDG Commons.
PUBLIC_ORIGIN=http://127.0.0.1:5174
AUTH_COOKIE_KEY=replace_with_a_random_32_byte_base64url_key
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
COMMONS_ORIGIN=https://class.mit-sdg.dev
