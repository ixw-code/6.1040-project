# Production profile. Copy to .env; replace both placeholder credentials.
WIKIPLOTTER_ENV=production
HOST=127.0.0.1
PORT=3000
# MongoDB configuration for Podman container. Omit if MongoDB instance is provided.
MONGO_INITDB_ROOT_USERNAME=replace_me
MONGO_INITDB_ROOT_PASSWORD=replace_me
MONGO_BIND_HOST=127.0.0.1
MONGO_PORT=27018
MONGODB_URI=mongodb://replace_me:replace_me@127.0.0.1:27018/wikiplotter?authSource=admin
# Frontend hosting. Omit if serving compiled frontend.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# Authentication: register the Google redirect URI PUBLIC_ORIGIN/auth/google/callback.
PUBLIC_ORIGIN=https://your-app.example
AUTH_COOKIE_KEY=replace_with_a_random_32_byte_base64url_key
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
COMMONS_ORIGIN=https://class.mit-sdg.dev
